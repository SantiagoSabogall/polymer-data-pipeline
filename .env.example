# Polymer Data Pipeline — API Keys
# Copy this file to API_KEY.env and fill in your keys.
# Keys for Springer, Elsevier, Semantic Scholar, and Lens are optional
# but significantly increase rate limits.

# Required for Crossref polite pool (used as User-Agent)
CROSSREF_POLITE_EMAIL=your.email@university.edu

# Optional — PubMed NCBI (increases rate limit from 3/s to 9/s)
NCBI_EMAIL=your.email@university.edu
PUBMED_API_KEY=your_ncbi_key

# Optional — Springer Meta API (increases from 1 req/s to 8 req/s)
SPRINGER_META_API_KEY=your_springer_key

# Optional — Elsevier Scopus API (increases from 1 req/s to 5 req/s)
ELSEVIER_API_KEY=your_elsevier_key

# Optional — OpenAlex (polite pool with email, free)
OPENALEX_EMAIL=your.email@university.edu
OPENALEX_API_KEY=

# Optional — Semantic Scholar (recommended for higher limits)
SEMANTIC_SCHOLAR_API_KEY=your_s2_key

# Optional — Lens.org API (required for Lens fetcher)
LENS_API_KEY=your_lens_key
